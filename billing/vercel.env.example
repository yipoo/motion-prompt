# Production template. Stripe API key is filled by the owner in Vercel.
# Database/auth can be shared; sandbox Stripe prices and webhook signatures cannot serve live payments.
APP_ENV=production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
BILLING_CATALOG=
SITE_URL=https://motion.yipoo.com/
ALLOWED_ORIGIN=https://motion.yipoo.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase transaction pooler, port 6543. Use its documented TLS settings.
DATABASE_URL=
PRIVATE_PACK_BUCKET=premium-packs
# Set only after actual premium content is delivered and reviewed.
PREMIUM_CONTENT_READY=false
PRO_CONTENT_READY=false
GITHUB_LOGIN_ENABLED=false
EMAIL_OTP_READY=false
